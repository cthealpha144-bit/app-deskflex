{
  "name": "Deskflex-app",
  "version": "10.0.0",
  "main": "Misc/main.js",
  "author": "cstuartday@gmail.com",
  "description": "Deskflex desktop application",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.deskflex.app",
    "productName": "Deskflex",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deskflex",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Deskflex-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "DisplaysDetector.exe",
        "to": "DisplaysDetector.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cthealpha144-bit",
        "repo": "app-deskflex"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  }
}
