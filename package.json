{
  "name": "deskplay-app",
  "version": "8.0.0",
  "main": "Misc/main.js",
  "author": "cstuartday@gmail.com",
  "description": "DeskPlay desktop application",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.deskplay.app",
    "productName": "DeskPlay",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "DisplaysDetector.exe",
        "to": "DisplaysDetector.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cthealpha144-bit",
        "repo": "app-deskplay"
      }
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  }
}
